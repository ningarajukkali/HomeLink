# ==============================================================================
# HomeLink Frontend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to '.env' or add these variables to your Vercel Project Dashboard:
# Vercel -> Project -> Settings -> Environment Variables
#
# NOTE: All Vite frontend variables MUST begin with 'VITE_' to be exposed to client.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API CONFIGURATION (MANDATORY FOR PRODUCTION)
# ------------------------------------------------------------------------------
# Deployed Backend API Base URL (always include the '/api' suffix)
# Examples:
#   - Production (Render):    https://homelink-backend.onrender.com/api
#   - Production (Railway):   https://homelink-api.up.railway.app/api
#   - Production (Vercel):    https://api.homelink.app/api
#   - Local Development:      http://localhost:5000/api  (or leave empty to use Vite /api proxy)
VITE_API_URL=https://homelink-backend.onrender.com/api

# ------------------------------------------------------------------------------
# 2. BRANDING & APPLICATION SETTINGS (OPTIONAL)
# ------------------------------------------------------------------------------
VITE_APP_NAME="HomeLink"
VITE_APP_TAGLINE="100% Verified Housing • 0% Brokerage"
VITE_APP_VERSION="2.0.0"

# Default selected city on initial user visit
# Available options: "All Cities", "Delhi NCR", "Bangalore", "Mumbai", "Hyderabad", "Rewa", "Pune", "Indore"
VITE_DEFAULT_CITY="Delhi NCR"

# ------------------------------------------------------------------------------
# 3. FEATURE FLAGS (OPTIONAL - Defaults to true if omitted)
# ------------------------------------------------------------------------------
# Enable floating AI Assistant chatbot
VITE_ENABLE_AI_ASSISTANT=true

# Enable Gemini forensic photo authenticity inspection & camera verification
VITE_ENABLE_PHOTO_AUDIT=true

# Enable live browser GPS auto-detection & nearby neighborhood amenities
VITE_ENABLE_GPS_DETECTION=true

# Enable side-by-side multi-property comparison matrix
VITE_ENABLE_COMPARE=true

# ------------------------------------------------------------------------------
# 4. EXTERNAL MAPPING & GEOCODING SERVICES (OPTIONAL)
# ------------------------------------------------------------------------------
# OpenStreetMap Nominatim reverse geocoding endpoint
VITE_GEO_NOMINATIM_URL="https://nominatim.openstreetmap.org/reverse"

# OpenStreetMap tile layer URL template
VITE_MAP_TILES_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"

# ------------------------------------------------------------------------------
# 5. SUPPORT & CONTACT METADATA (OPTIONAL)
# ------------------------------------------------------------------------------
VITE_SUPPORT_PHONE="+91 98765 43210"
VITE_SUPPORT_WHATSAPP="+919876543210"
VITE_SUPPORT_EMAIL="support@homelink.in"

# ------------------------------------------------------------------------------
# 6. RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to 'production' on Vercel deployments
VITE_ENVIRONMENT=production
